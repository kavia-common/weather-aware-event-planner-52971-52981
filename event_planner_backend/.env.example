# Flask
SECRET_KEY=change-me
FLASK_DEBUG=1

# Database
# DATABASE_URL=sqlite:///event_planner.sqlite3

# OpenAPI docs
API_TITLE=Weather-Aware Event Planner API
API_VERSION=v1
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/docs

# OpenWeatherMap configuration (Required)
OPENWEATHERMAP_API_KEY=your-api-key
# Optional tweaks
OPENWEATHERMAP_UNITS=metric
OPENWEATHERMAP_LANG=en
HTTP_TIMEOUT_SECONDS=15
