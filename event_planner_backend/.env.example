# Flask
SECRET_KEY=dev-secret-key
FLASK_DEBUG=1

# Database (defaults to sqlite file if not set)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# SQLALCHEMY_DATABASE_URI=sqlite:///event_planner.sqlite3

# OpenWeatherMap configuration
# REQUIRED: Provide a valid API key for live weather to work
OPENWEATHERMAP_API_KEY=your_openweather_api_key_here

# Optional preferences
OPENWEATHERMAP_UNITS=metric
OPENWEATHERMAP_LANG=en

# HTTP client timeout
HTTP_TIMEOUT_SECONDS=15
